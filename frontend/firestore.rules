rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userId() {
      return request.auth.uid;
    }

    // Users collection: users can read their own data.
    // Writes should go through the secure backend APIs to prevent tampering with approvalStatus and roles.
    match /users/{uid} {
      allow read: if signedIn() && uid == userId();
      allow write: if false; // Only backend admin SDK can write
    }

    match /organizations/{docId} {
      allow read: if signedIn() && get(/databases/$(database)/documents/users/$(userId())).data.approvalStatus == 'approved';
      allow write: if false;
    }

    // Catch-all: block access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
