rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userId() {
      return request.auth.uid;
    }

    // Users collection: one doc per Firebase UID
    match /users/{uid} {
      allow read, create, update, delete: if signedIn() && uid == userId();
    }

    // Schools collection: only allow access to the user's own school
    match /schools/{schoolId} {
      allow read: if signedIn() &&
        exists(/databases/$(database)/documents/users/$(userId())) &&
        get(/databases/$(database)/documents/users/$(userId())).data.schoolId == schoolId;

      // Allow creating/updating the user's own school doc (onboarding).
      allow create, update: if signedIn() &&
        exists(/databases/$(database)/documents/users/$(userId())) == false &&
        request.resource.data.createdBy == userId();

      // If user doc already exists, allow update only when school matches.
      allow update: if signedIn() &&
        exists(/databases/$(database)/documents/users/$(userId())) &&
        get(/databases/$(database)/documents/users/$(userId())).data.schoolId == schoolId;

      // Prevent deletions from client
      allow delete: if false;
    }

    // Generic pattern for any school-scoped collections (optional, extend later)
    match /{collectionId}/{docId} {
      allow read, write: if false;
    }
  }
}

