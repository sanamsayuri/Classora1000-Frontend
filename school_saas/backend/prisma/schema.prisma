generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
}

enum FeeFrequency {
  MONTHLY
  TERMLY
  YEARLY
  ONE_TIME
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PaymentMode {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
}

enum CertificateType {
  LEAVING
  CHARACTER
  MERIT
  OTHER
}

enum NoticeAudience {
  ALL
  TEACHERS
  STUDENTS
  PARENTS
}

model School {
  id            String   @id @default(uuid())
  name          String
  subdomain     String   @unique
  domain        String?  @unique
  contact_email String?
  address       String?
  active        Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  users          User[]
  parents        Parent[]
  teachers       Teacher[]
  students       Student[]
  classes        Class[]
  sections       Section[]
  attendance     Attendance[]
  fee_structures FeeStructure[]
  fee_payments   FeePayment[]
  exams          Exam[]
  marks          Mark[]
  certificates   Certificate[]
  notices        Notice[]
  assignments    Assignment[]
  payments       Payment[]
}

model User {
  id            String   @id @default(uuid())
  school_id     String?
  email         String
  password_hash String
  role          Role     @default(PARENT)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  school   School?   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  profile  Profile?
  payments Payment[]

  parent_profile  Parent?
  teacher_profile Teacher?
  student_profile Student?

  @@unique([school_id, email])
}

model Profile {
  id         String  @id @default(uuid())
  user_id    String  @unique
  first_name String
  last_name  String
  phone      String?

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Payment {
  id                  String   @id @default(uuid())
  school_id           String
  user_id             String
  amount              Float
  status              String
  razorpay_order_id   String?
  razorpay_payment_id String?
  created_at          DateTime @default(now())

  school School @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Parent {
  id         String   @id @default(uuid())
  school_id  String
  user_id    String?  @unique
  first_name String
  last_name  String
  phone      String?
  address    String?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  school   School    @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  students Student[]
}

model Teacher {
  id          String   @id @default(uuid())
  school_id   String
  user_id     String?  @unique
  first_name  String
  last_name   String
  employee_id String
  designation String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  school      School       @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [user_id], references: [id], onDelete: SetNull)
  sections    Section[]
  assignments Assignment[]

  @@unique([school_id, employee_id])
}

model Class {
  id         String   @id @default(uuid())
  school_id  String
  name       String
  level      Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  school         School         @relation(fields: [school_id], references: [id], onDelete: Cascade)
  sections       Section[]
  fee_structures FeeStructure[]
  exams          Exam[]

  @@unique([school_id, name])
}

model Section {
  id               String   @id @default(uuid())
  school_id        String
  class_id         String
  name             String
  class_teacher_id String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  school        School   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  class         Class    @relation(fields: [class_id], references: [id], onDelete: Cascade)
  class_teacher Teacher? @relation(fields: [class_teacher_id], references: [id], onDelete: SetNull)

  students    Student[]
  attendance  Attendance[]
  assignments Assignment[]

  @@unique([school_id, class_id, name])
}

model Student {
  id               String    @id @default(uuid())
  school_id        String
  user_id          String?   @unique
  parent_id        String?
  section_id       String?
  first_name       String
  last_name        String
  admission_number String
  dob              DateTime?
  enrollment_date  DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  school  School   @relation(fields: [school_id], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  parent  Parent?  @relation(fields: [parent_id], references: [id], onDelete: SetNull)
  section Section? @relation(fields: [section_id], references: [id], onDelete: SetNull)

  attendance   Attendance[]
  fee_payments FeePayment[]
  marks        Mark[]
  certificates Certificate[]

  @@unique([school_id, admission_number])
}

model Attendance {
  id          String           @id @default(uuid())
  school_id   String
  student_id  String
  section_id  String
  record_date DateTime         @db.Date
  status      AttendanceStatus
  remarks     String?
  created_at  DateTime         @default(now())
  updated_at  DateTime         @updatedAt

  school  School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
  section Section @relation(fields: [section_id], references: [id], onDelete: Cascade)

  @@unique([school_id, student_id, record_date])
}

model FeeStructure {
  id         String       @id @default(uuid())
  school_id  String
  class_id   String
  fee_name   String
  amount     Float
  frequency  FeeFrequency
  due_day    Int?
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  school       School       @relation(fields: [school_id], references: [id], onDelete: Cascade)
  class        Class        @relation(fields: [class_id], references: [id], onDelete: Cascade)
  fee_payments FeePayment[]
}

model FeePayment {
  id               String        @id @default(uuid())
  school_id        String
  student_id       String
  fee_structure_id String
  amount_paid      Float
  payment_date     DateTime      @db.Date
  payment_mode     PaymentMode?
  status           PaymentStatus
  transaction_ref  String?
  created_at       DateTime      @default(now())
  updated_at       DateTime      @updatedAt

  school        School       @relation(fields: [school_id], references: [id], onDelete: Cascade)
  student       Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)
  fee_structure FeeStructure @relation(fields: [fee_structure_id], references: [id], onDelete: Restrict)
}

model Exam {
  id         String    @id @default(uuid())
  school_id  String
  class_id   String
  name       String
  start_date DateTime? @db.Date
  end_date   DateTime? @db.Date
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  school School @relation(fields: [school_id], references: [id], onDelete: Cascade)
  class  Class  @relation(fields: [class_id], references: [id], onDelete: Cascade)
  marks  Mark[]
}

model Mark {
  id             String   @id @default(uuid())
  school_id      String
  exam_id        String
  student_id     String
  subject_name   String
  marks_obtained Float
  max_marks      Float
  remarks        String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  school  School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  exam    Exam    @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([school_id, exam_id, student_id, subject_name])
}

model Certificate {
  id               String          @id @default(uuid())
  school_id        String
  student_id       String
  certificate_type CertificateType
  issue_date       DateTime        @db.Date
  content          String?
  created_at       DateTime        @default(now())
  updated_at       DateTime        @updatedAt

  school  School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  student Student @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model Notice {
  id              String         @id @default(uuid())
  school_id       String
  title           String
  content         String
  target_audience NoticeAudience
  publish_date    DateTime       @db.Date
  expiry_date     DateTime?      @db.Date
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  school School @relation(fields: [school_id], references: [id], onDelete: Cascade)
}

model Assignment {
  id          String    @id @default(uuid())
  school_id   String
  section_id  String
  teacher_id  String
  title       String
  description String?
  due_date    DateTime? @db.Date
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  school  School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
  section Section @relation(fields: [section_id], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
}
